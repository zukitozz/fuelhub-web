# ============================================================================
# FuelWeb — variables de entorno
# Copia este archivo a .env.local y completa los valores reales.
# Ver README.md para de dónde sale cada uno.
# NUNCA pongas valores reales en este archivo — es el que se sube a git.
# ============================================================================

# --- NextAuth (sesión de persona en FuelWeb) ---------------------------------
NEXTAUTH_URL=http://localhost:3000
# Genera uno con: openssl rand -base64 32
NEXTAUTH_SECRET=

# --- Cognito pool "jdpalk" (login de personas, App Client NUEVO, Hosted UI) --
# Issuer = https://cognito-idp.<region>.amazonaws.com/<userPoolId>
# El pool jdpalk es us-east-2_56X8JF6jR (sección 2.5 de la spec).
COGNITO_JDPALK_ISSUER=https://cognito-idp.us-east-2.amazonaws.com/us-east-2_56X8JF6jR
COGNITO_JDPALK_CLIENT_ID=
COGNITO_JDPALK_CLIENT_SECRET=
# Dominio de Hosted UI del pool jdpalk (para armar el signOut redirect). Ej:
# https://jdpalk-xxxx.auth.us-east-2.amazoncognito.com
COGNITO_JDPALK_HOSTED_UI_DOMAIN=

# --- Sesión M2M de FuelWeb hacia FuelHub Cloud (App Client NUEVO, back-office)
# station_scope=*, scopes cierres.read + cierres.write.
FUELHUB_TOKEN_URL=https://us-east-2nq1gjcb0j.auth.us-east-2.amazoncognito.com/oauth2/token
FUELHUB_M2M_CLIENT_ID=
FUELHUB_M2M_CLIENT_SECRET=

# --- API real de FuelHub Cloud ------------------------------------------------
FUELHUB_API_BASE_URL=https://api.fuelhub.cloud
